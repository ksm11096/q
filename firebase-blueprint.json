{
  "entities": {
    "Prompt": {
      "title": "Prompt",
      "description": "An AI prompt entry saved in the user's prompt warehouse.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the prompt.",
          "minLength": 1,
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "description": "The category of the prompt.",
          "enum": ["사진 합성", "스타일 변환", "캐릭터·포스터"]
        },
        "content": {
          "type": "string",
          "description": "The full prompt text including line breaks and formatting.",
          "minLength": 1,
          "maxLength": 20000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the prompt was created."
        }
      },
      "required": ["title", "category", "content", "createdAt"]
    }
  },
  "firestore": {
    "/prompts/{promptId}": {
      "schema": { "$ref": "#/entities/Prompt" },
      "description": "Collection storing all AI prompts ordered by creation time."
    }
  }
}
